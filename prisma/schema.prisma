// Prisma schema for tk-auto-reply
// Lightweight SQLite database

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  // url is now configured in prisma.config.ts (Prisma 7+)
}

// TikTok 用户（与脚本上报的 tiktokUserId 关联）
model TikTokUser {
  id           String   @id @default(cuid())
  tiktokUserId String   @unique // TikTok 侧的用户标识（从脚本上报）
  displayName  String?
  avatarUrl    String?
  notes        String?  // 管理员备注
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  sessions     Session[]
  messages     Message[]
}

// 会话（每个 TikTok 用户可以有多个会话，便于区分不同对话上下文）
model Session {
  id           String   @id @default(cuid())
  userId       String
  user         TikTokUser @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String?  // 会话标题（可选，例如根据首条消息生成）
  context      String?  // JSON 或摘要，用于长期记忆
  lastActiveAt DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  messages     Message[]

  @@index([userId])
  @@index([lastActiveAt])
}

// 消息（用户 / AI）
model Message {
  id        String   @id @default(cuid())
  sessionId String
  session   Session  @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  userId    String?  // 如果是用户消息，关联到 TikTokUser
  user      TikTokUser? @relation(fields: [userId], references: [id], onDelete: SetNull)
  role      String   // "user" | "assistant" | "system"
  content   String   // 消息文本
  metadata  String?  // JSON，可存额外信息（token 数、模型、延迟等）
  createdAt DateTime @default(now())

  @@index([sessionId])
  @@index([createdAt])
}
